---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = {
  title: 'Über mich',
  description: 'Lerne die Schweizer Badmintonspielerin Milena Schnider kennen.',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Über mich" title="Milena Schnider" />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-16 md:pb-24">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold text-heading dark:text-white">Mein Weg im Badminton</h2>
      <p class="mt-4 text-lg text-muted dark:text-gray-300">
        Ich bin Milena Schnider, Schweizer Badmintonspielerin. Hier erzähle ich mehr über meinen sportlichen Weg,
        meine Motivation und den Alltag im Badminton.
      </p>
      <p class="mt-3 text-muted dark:text-gray-300">Weitere persönliche Einblicke folgen.</p>
    </div>
  </section>
</Layout>
