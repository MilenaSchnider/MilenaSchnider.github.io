---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = {
  title: 'Erfolge',
  description: 'Turniere, Resultate und sportliche Meilensteine von Milena Schnider.',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Wettkampf" title="Erfolge" />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-16 md:pb-24">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold text-heading dark:text-white">Turniere und Resultate</h2>
      <p class="mt-4 text-lg text-muted dark:text-gray-300">
        Hier findest du eine Übersicht meiner Turniere, Resultate und sportlichen Meilensteine.
      </p>
      <p class="mt-3 text-muted dark:text-gray-300">Die Übersicht wird laufend ergänzt.</p>
    </div>
  </section>
</Layout>