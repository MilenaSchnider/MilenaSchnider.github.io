---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = {
  title: 'Kontakt',
  description: 'Kontaktseite von Milena Schnider für allgemeine und Sponsoringanfragen.',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Kontakt" title="Kontakt" />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-16 md:pb-24">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold text-heading dark:text-white">Anfragen</h2>
      <p class="mt-4 text-lg text-muted dark:text-gray-300">
        Die Kontaktmöglichkeiten werden hier ergänzt. Informationen zu Partnerschaften findest du auf der
        <a class="font-semibold text-primary underline underline-offset-4" href="/sponsoren">Sponsoren-Seite</a>.
      </p>
    </div>
  </section>
</Layout>
